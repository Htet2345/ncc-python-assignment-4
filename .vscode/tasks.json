{
  "version": "2.0.0",
  "tasks": [
    {"label": "Django: Setup", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1"], "problemMatcher": []},
    {"label": "Django: Migrate", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["manage.py", "migrate"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Django: Run server", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/run.ps1"], "problemMatcher": [], "presentation": {"panel": "dedicated", "reveal": "always"}},
    {"label": "Django: Test", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["manage.py", "test"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ]
}
